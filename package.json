{
  "name": "heyhey",
  "version": "0.1.0",
  "private": true,
  "description": "HeyHey! - Online multiplayer Nertz card game",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @heyhey/server",
    "dev:client": "npm run dev -w @heyhey/client",
    "build": "npm run build -w @heyhey/shared && npm run build -w @heyhey/server && npm run build -w @heyhey/client",
    "build:shared": "npm run build -w @heyhey/shared",
    "build:server": "npm run build -w @heyhey/server",
    "build:client": "npm run build -w @heyhey/client",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
